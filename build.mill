//| mill-version: 1.1.2
//| mill-jvm-version: temurin:21
//| mvnDeps:
//| - uk.org.wilton::ietf-yang-mill-plugin::0.0.11

package build

import mill.*, scalalib.*
import uk.org.wilton.ietf.yang.mill.plugin.*

object `package` extends IETF:
  def draft = Task.Source:
    "draft-ietf-netconf-yang-push-2.md"

  // All RFCs that we need to extract YANG from.
  def rfcDeps = List(
    8525, // Replaces 7895
    8072, 8341, 8342, 8343, 8344, 8529, 8641, 8791, 9196, 9640, 9641, 9642,
    9643, 9645, 9911,
    8040, 8639 // SHOULD NOT BE NEEDED.  Req to add publisher-id to envelope.
  )

  // All drafts that we need to extract YANG from.
  def draftDeps = Seq(
    "draft-ietf-netconf-https-notif-16",
    "draft-ietf-netconf-udp-notif-26",
    "draft-ietf-netconf-udp-client-server-10",
    "draft-ietf-netconf-distributed-notif-23",
    "draft-ietf-netconf-http-client-server-33",
    "draft-ietf-netconf-yang-notifications-versioning-17",
    "draft-ietf-netconf-yang-library-augmentedby-18",
    "draft-ietf-netmod-yang-module-versioning-17",
    "draft-ietf-netmod-yang-semver-29",
    "draft-netana-netconf-yp-transport-capabilities-01",
  )

  // IANA YANG dependencies.
  def ianaDeps = Seq(
    "iana-tls-cipher-suite-algs@2024-10-16.yang"
  )

  def extractedFileRenames = Map(
      "ietf-distributed-notif@2024-04-14.yang" -> "ietf-distributed-notif@2024-04-21.yang",
      "ietf-yang-push-revision@2024-05-28.yang" -> "ietf-yang-push-revision@2024-06-16.yang"
    )

  def excludedModules = Set(
    "ietf-https-notif-transport@2024-02-01.yang",
    "ietf-yang-library-rfc7895-augmentedby.yang"
  )

  def yangCompiles = Seq(
    Seq("ietf-yang-push-2.yang", "ietf-yang-push-2-config.yang"),
    Seq("ietf-yang-push-2-capabilities.yang", "ietf-yang-push-2.yang"),
    Seq("ietf-udp-notif-transport-2.yang", "ietf-yang-push-2.yang")
  )

  def yangTrees = Seq(
    (Seq("ietf-yang-push-2.yang"), "ietf-yang-push-2-tree.txt", None),
    (Seq("ietf-yang-push-2.yang"), "ietf-yang-push-2-envelope-tree.txt", Some("envelope")),
    (Seq("ietf-yang-push-2-config.yang"), "filters.txt", Some("datastore-telemetry/filters")),
    (Seq("ietf-yang-push-2-config.yang"), "subscriptions.txt", Some("datastore-telemetry/subscriptions")),
    (Seq("ietf-yang-push-2-config.yang"), "update-trigger.txt", Some("datastore-telemetry/subscriptions/subscription/update-trigger")),
    (Seq("ietf-yang-push-2-config.yang"), "receivers.txt", Some("datastore-telemetry/receivers")),
    (Seq("ietf-yang-push-2-config.yang"), "ietf-yang-push-2-config-tree.txt", None),
    (Seq("ietf-yang-push-2-capabilities.yang"), "ietf-yang-push-2-capabilities-tree.txt", None),
    (Seq("ietf-yang-push-2-capabilities.yang", "ietf-system-capabilities@2022-02-17.yang"), "ietf-system-capabilities-tree.txt", None)
  )

  // The plugin does not expose pyang's option to print sx:structure trees.
  override def buildYangTree(
      pyang: os.Path,
      yangDeps: Seq[os.Path],
      yangFiles: Seq[os.Path],
      target: os.Path,
      treePath: Option[String]
  ): Option[String] =
    if target.last == "ietf-yang-push-2-envelope-tree.txt" then
      val result = os.proc(
        pyang,
        "-f", "tree",
        "--tree-print-structures",
        "--tree-path", treePath.get,
        "--tree-line-length=69",
        "-p", yangDeps.mkString(":"),
        "-o", target,
        yangFiles
      ).call(mergeErrIntoOut = true, check = false)
      if result.exitCode == 0 then None else Some(result.out.text())
    else
      super.buildYangTree(pyang, yangDeps, yangFiles, target, treePath)

  def yangTreeSnippets = Seq(
    ("ietf-yang-push-2-envelope-tree.txt", "structure envelope:", "<end>", "envelope.txt"),
    ("ietf-yang-push-2-tree.txt", "-x establish-subscription", "-x modify-subscription", "establish-subscription.txt"),
    ("ietf-yang-push-2-tree.txt", "-x modify-subscription", "-x delete-subscription", "modify-subscription.txt"),
    ("ietf-yang-push-2-tree.txt", "-x delete-subscription", "-x kill-subscription", "delete-subscription.txt"),
    ("ietf-yang-push-2-tree.txt", "-x kill-subscription", "notifications", "kill-subscription.txt"),
    ("ietf-yang-push-2-tree.txt", "-n subscription-started", "subscription-modified", "subscription-started.txt"),
    ("ietf-yang-push-2-tree.txt", "-n subscription-modified", "subscription-terminated", "subscription-modified.txt"),
    ("ietf-yang-push-2-tree.txt", "-n subscription-terminated", "update", "subscription-terminated.txt"),
    ("ietf-yang-push-2-tree.txt", "-n update$", "-n update-complete", "update-notification.txt"),
    ("ietf-yang-push-2-tree.txt", "-n update-complete", "<end>", "update-complete.txt"),
  )

  def all = Task:
    checkDraftLatest()
    make()
    println(s"Task all Finished")



  object publisher extends ScalaModule:
    def scalaVersion = "3.7.3"
    def mvnDeps = Seq(
      mvn"com.lihaoyi::upickle:4.3.1",
      mvn"com.lihaoyi::mainargs:0.7.6",
      mvn"org.scala-lang.modules::scala-xml:2.3.0"
    )

/*
 * Run manually to generate the requests:
 *
 * There should be a way to hook this into the build script.
 *
 * ./mill publisher.run netconfExample --max-line-length=69 --path="ietf-interfaces:interfaces/interface/statistics"
 *   --description="Interface statistics, 30s period" -n "interface-statistics" -o examples/netconf/rpc/netconf-establish-sub-if-stats.xml
 *
 * And the reply:
 * ./mill -i publisher.run netconfReply --max-line-length=69 -o examples/netconf/rpc/establish-subscription-reply.xml
 */
